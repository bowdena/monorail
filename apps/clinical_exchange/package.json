{
  "name": "app",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@herb-tools/formatter": "^0.10.2",
    "@herb-tools/linter": "^0.10.3",
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --preserve-symlinks --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "herb:lint": "herb-lint",
    "herb:format": "herb-format app/views",
    "herb:format:check": "herb-format --check app/views"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "basecoat-css": "^1.0.1",
    "gesso": "link:../../gems/gesso/app/javascript"
  }
}
