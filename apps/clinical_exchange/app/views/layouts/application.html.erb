<!DOCTYPE html>

<html>
  <head>
    <%#
      Runs before first paint so a stored dark preference does not flash
      unstyled. Stimulus cannot do this — it runs after the paint.
    %>

    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        var t = localStorage.getItem("theme-preference") || "system";
        if (t === "dark" ||
            (t === "system" &&
             window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <title><%= content_for(:title) || "Clinical Exchange" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Clinical Exchange">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%# = tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%#
      Link the compiled stylesheets by name: :app would also link the
      tailwindcss-rails build input for the gesso engine, whose
      generated @import is an absolute path the browser cannot fetch.
    %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="flex h-screen overflow-hidden bg-background">
    <%= render_sidebar(
          app_name: "Clinical Exchange",
          nav_items: [
            { label: "Dashboard", path: "/", icon: "layout-dashboard" },
            { label: "Patients", path: "/patients", icon: "users" }
          ]
        ) %>

    <div class="flex flex-col flex-1 overflow-hidden min-w-0">
      <%= render_header(title: content_for(:title), show_search: false) %>

      <main class="flex-1 overflow-auto p-6">
        <%= render_toast(flash: flash) %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
