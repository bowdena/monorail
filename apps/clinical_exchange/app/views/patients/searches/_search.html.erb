<%# locals: (results: nil, urn: nil, failure: nil, throttled: false) %>
<%#
  The search form and its results, together inside the turbo frame the
  search replaces.

  Params:
    results   - a Patient::Results, or nil before any search has run
    urn       - the urn searched for, redisplayed in the field
    failure   - a Conduit::Error the search could not recover from
    throttled - true when the search was refused for coming too fast
%>

<%= turbo_frame_tag "patient_search" do %>
  <div class="space-y-6">
    <%= render_card do %>
      <p class="text-sm text-muted-foreground mb-4">
        Enter a patient's URN (up to 7 digits). Leading zeros are added
        automatically.
      </p>

      <%= form_with url: patients_search_path, class: "flex gap-3" do |form| %>
        <%= form.label :urn, "URN", class: "sr-only" %>

        <%= form.text_field :urn, value: urn,
              inputmode: "numeric", maxlength: Patient::URN_LENGTH,
              placeholder: "Enter URN (e.g. 1234567)",
              autocomplete: "off", class: "input max-w-xs" %>

        <%= render_button(type: "submit") do %>
          <%= inline_svg_tag "icons/search.svg", class: "size-4" %> Search
        <% end %>
      <% end %>
    <% end %>

    <% if throttled %>
      <%= render_alert(variant: "warning", icon: "icons/alert-triangle",
            title: "Too many searches") do %>
        Searching is paused for a minute. Wait, then search again.
      <% end %>
    <% end %>

    <% if failure %>
      <%= render_alert(variant: "critical", icon: "icons/x-circle",
            title: "Search unavailable") do %>
        Patient records could not be searched. This needs fixing by an
        administrator — report it rather than retrying.
      <% end %>
    <% end %>

    <% if results&.local? %>
      <%= render_alert(variant: "warning", icon: "icons/alert-triangle",
            title: "iPM is unavailable") do %>
        Showing patients kept from earlier lookups, which may be out of date.
        Patients never looked up here will not appear.
      <% end %>
    <% end %>

    <% if results %>
      <% if results.records.any? %>
        <%= render_card(title: "Results") do %>
          <div class="overflow-x-auto">
            <table class="table">
              <caption class="sr-only">Patients matching your search</caption>

              <thead>
                <tr>
                  <th>Name</th>
                  <th>URN</th>
                  <th>Date of birth</th>
                  <th>Gender</th>
                </tr>
              </thead>

              <tbody>
                <% results.records.each do |patient| %>
                  <tr>
                    <td class="font-medium"><%= patient_name(patient) %></td>
                    <td><%= patient.urn %></td>
                    <td><%= patient_date_of_birth(patient) %></td>
                    <td><%= patient.gender %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% elsif results.local? %>
        <%= render_alert(icon: "icons/alert-circle",
              title: "No saved patient matches") do %>
          No patient kept from an earlier lookup has URN <%= urn %>. Whether iPM
          holds one cannot be checked until it is reachable.
        <% end %>
      <% else %>
        <%= render_alert(icon: "icons/alert-circle", title: "No patient found") do %>
          No patient has URN <%= urn %>. Check the number and search again.
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
