<div class="flex flex-col gap-4 p-4">
  <table class="w-full text-left text-sm">
    <thead>
      <tr>
        <th class="pb-2 font-medium">Variant</th>
        <th class="pb-2 font-medium">Rendered</th>
        <th class="pb-2 font-medium">Attribute</th>
      </tr>
    </thead>
    <tbody>
      <% %w[ primary secondary outline destructive success warning info
             critical stale ].each do |variant| %>
        <tr>
          <td class="py-1 pr-4"><%= variant %></td>
          <td class="py-1 pr-4">
            <span class="badge" data-variant="<%= variant %>"><%= variant.capitalize %></span>
          </td>
          <td class="py-1"><code>data-variant="<%= variant %>"</code></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
