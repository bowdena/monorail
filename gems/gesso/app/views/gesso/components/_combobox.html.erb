<%#
  locals: (name: nil, options: [], selected: "",
  current_label: "Select…", searchable: true, id: nil)
%>
<%#
  Combobox component.

  Rendered via render_combobox (Gesso::Components::ComboboxHelper), which
  normalises the selected value and resolves the trigger label. This
  partial only renders markup.

  A searchable select using basecoat select.js. Opens a filterable
  listbox popover on click; the selected value is tracked in a hidden
  input for form submission. The check indicator on the selected item
  is CSS-driven via aria-selected — no extra markup is required.

  Params:
    name          - hidden input name (for form submission)
    options       - array of { value:, label: } hashes
    selected      - the selected value, stringified
    current_label - label shown on the trigger (selected label or
                    placeholder)
    searchable    - show the search filter in the popover (default: true)
    id            - optional id for the hidden input
%>

<%= tag.div class: "select" do %>
  <%= hidden_field_tag name, selected, id: id %>

  <%= button_tag type: "button", name: nil, class: "btn",
        data: { variant: "outline" },
        aria: { expanded: "false", haspopup: "listbox" } do %>
    <%= tag.span current_label %>
    <%= inline_svg_tag "icons/chevron-down.svg", class: "size-4 opacity-50" %>
  <% end %>

  <%= tag.div data: { popover: "" }, aria: { hidden: true } do %>
    <% if searchable %>
      <%= tag.header do %>
        <%= inline_svg_tag "icons/search.svg" %>

        <%= tag.input type: "text", role: "combobox",
              placeholder: "Search…", autocomplete: "off" %>
      <% end %>
    <% end %>

    <%= tag.ul role: "listbox", data: { empty: "No results found." } do %>
      <% options.each do |option| %>
        <%= tag.li option[:label],
              role: "option",
              data: { value: option[:value] },
              aria: { selected: (option[:value].to_s == selected) ? true : nil } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
