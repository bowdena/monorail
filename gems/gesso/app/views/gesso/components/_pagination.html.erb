<%# locals: (pages: [], previous: nil, next_page: nil) %>
<%#
  Pagination component.

  Rendered via render_pagination (Gesso::Components::PaginationHelper). This
  partial only renders markup.

  Renders a handed-in page window — it does no page-window maths itself.
  The caller computes which pages to show (and where the ellipses fall)
  and hands the window in. The current page is the outline button
  variant and carries aria-current; the rest are ghost.

  Params:
    pages    - array of the window to render. Each entry is either a hash
               { number:, path:, current: } or the symbol :gap, which
               renders an ellipsis.
    previous - { path: } for the previous-page link, or nil to omit it
               (e.g. on the first page).
    next_page - { path: } for the next-page link, or nil to omit it
                (e.g. on the last page). Named next_page because `next`
                is a Ruby keyword.
%>

<%= tag.nav role: "navigation", aria: { label: "Pagination" },
      class: "mx-auto flex w-full justify-center" do %>
  <%= tag.ul class: "flex flex-row items-center gap-1" do %>
    <% if previous %>
      <%= tag.li do %>
        <%= link_to previous[:path], class: "btn",
              data: { variant: "ghost" },
              aria: { label: "Go to previous page" } do %>
          <%= inline_svg_tag "icons/chevron-left.svg", class: "size-4",
                data: { icon: "inline-start" } %>

          <%= tag.span "Previous" %>
        <% end %>
      <% end %>
    <% end %>

    <% pages.each do |entry| %>
      <%= tag.li do %>
        <% if entry == :gap %>
          <%= tag.span aria: { hidden: true },
                class: "flex size-9 items-center justify-center" do %>
            <%= inline_svg_tag "icons/more-horizontal.svg", class: "size-4" %>
            <%= tag.span "More pages", class: "sr-only" %>
          <% end %>
        <% else %>
          <%= link_to entry[:number], entry[:path], class: "btn",
                data: { variant: entry[:current] ? "outline" : "ghost",
                        size: "icon" },
                aria: { current: entry[:current] ? "page" : nil } %>
        <% end %>
      <% end %>
    <% end %>

    <% if next_page %>
      <%= tag.li do %>
        <%= link_to next_page[:path], class: "btn",
              data: { variant: "ghost" },
              aria: { label: "Go to next page" } do %>
          <%= tag.span "Next" %>

          <%= inline_svg_tag "icons/chevron-right.svg", class: "size-4",
                data: { icon: "inline-end" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
