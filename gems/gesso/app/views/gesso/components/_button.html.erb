<%# locals: (variant:, size:, type: "button", loading: false, disabled: false, classes: nil, aria: nil) %>
<%#
  Button component.

  Rendered via render_button (Gesso::Components::ButtonHelper), which validates
  variant/size. This partial only renders markup — it does no class
  composition itself.

  Params:
    variant  - basecoat variant, rendered as data-variant; nil for the
               default variant (primary, secondary, outline, ghost,
               link, destructive, warning, info)
    size     - basecoat size, rendered as data-size; nil for the default
               size (xs, sm, lg, icon, icon-xs, icon-sm, icon-lg)
    type     - button | submit | reset  (default: "button")
    loading  - when true, shows a spinner and disables the button
    disabled - when true, disables the button
    classes  - additional CSS classes
    aria     - hash of aria attributes, e.g. { label: "Close" }; an
               icon-only button needs one to have an accessible name
%>

<%# name: nil drops button_tag's default name="button" attribute. %>
<%= button_tag(
      type:,
      name: nil,
      aria:,
      class: class_names("btn", classes),
      disabled: disabled || loading,
      data: {
        variant:,
        size:,
        controller: "button",
        action: "button#load",
        button_loading_value: loading
      }
    ) do %>
  <span data-button-target="spinner" class="btn-spinner<%= " hidden" unless loading %>" aria-hidden="true"></span>
  <span data-button-target="content"><%= yield %></span>
<% end %>
