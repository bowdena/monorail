require "bundler/setup"

APP_RAKEFILE = File.expand_path("spec/dummy/Rakefile", __dir__)
load "rails/tasks/engine.rake"

require "bundler/gem_tasks"

# Engine-local tasks (lint, …). Kept in tasks/ rather than lib/tasks/ so
# Rails does not export them into consuming apps' rake.
Dir.glob(File.expand_path("tasks/*.rake", __dir__)).each { |task| load task }
